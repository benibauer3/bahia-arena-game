# ─── Bahia Arena — Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Private key of the deployer wallet (with 0x prefix)
# This wallet needs CELO for gas (~0.05 CELO)
PRIVATE_KEY=0x_your_deployer_private_key_here

# Treasury wallet — receives 40% of monthly yield
# Default: deployer address. Use a multisig for production.
TREASURY_ADDRESS=0xYourMultisigOrTreasuryAddress

# Celoscan API key for contract verification (optional)
# Get it at: https://celoscan.io/myapikey
CELOSCAN_API_KEY=your_celoscan_api_key_here
