# ─── Bahia Arena — Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Private key of the deployer wallet (with 0x prefix)
# This wallet needs CELO for gas (~0.05 CELO)
PRIVATE_KEY=0x_your_deployer_private_key_here

# Treasury wallet — receives 40% of monthly yield
# Default: deployer address. Use a multisig for production.
TREASURY_ADDRESS=0xYourMultisigOrTreasuryAddress

# Celoscan API key for contract verification (optional)
# Get it at: https://celoscan.io/myapikey
CELOSCAN_API_KEY=your_celoscan_api_key_here

# ─── X (Twitter) API ─────────────────────────────────────────────────────────
# OAuth 2.0 PKCE — No client secret needed (public client).
#
# Steps:
#  1. Go to https://developer.twitter.com/en/portal/projects-and-apps
#  2. Create a new App → App type: "Native App"
#  3. Under "User authentication settings":
#     - OAuth 2.0 → ON
#     - Type of App: Single Page App
#     - Callback URI:  https://your-domain.com/profile
#                      http://localhost:5173/profile   (for local dev)
#     - Website URL:   https://your-domain.com
#  4. Required permissions (scopes):
#     tweet.read  users.read  tweet.write  offline.access
#  5. Copy the Client ID (NOT the secret) below

# Frontend — exposed to browser (safe; this is a public client ID)
VITE_X_CLIENT_ID=your_x_oauth2_client_id_here
